@{
    Layout = null;
    ViewBag.Title = "Student Dashboard";
    var studentId = Context.Session.GetInt32("UserID");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Dashboard</title>

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom Dashboard CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body class="student-dashboard">

    <!-- Background Layer -->
    <div class="background-wrapper-student">
        <div class="blur-layer"></div>
    </div>

    <!-- Dashboard Container -->
    <div class="dashboard-container">
        <h1 class="dashboard-header">
            <i class="fas fa-user-graduate"></i> Welcome, Student @studentId
        </h1>

        <!-- Tile Grid -->
        <div class="tile-grid">

            <!-- Announcements -->
            <a href="/StudentAnnouncement/List?studentId=@studentId" class="tile-card student-tile">
                <div class="tile-hover-glow"></div>
                <i class="fas fa-bullhorn tile-icon"></i>
                <h3>View Announcements</h3>
            </a>

            <!-- Join Classroom -->
            <a href="/StudentEnrollment/Register" class="tile-card student-tile">
                <div class="tile-hover-glow"></div>
                <i class="fas fa-plus tile-icon"></i>
                <h3>Join Classroom</h3>
            </a>

            <!-- My Classrooms -->
            <a href="/StudentEnrollment/MyClassrooms?studentId=@studentId" class="tile-card student-tile">
                <div class="tile-hover-glow"></div>
                <i class="fas fa-school tile-icon"></i>
                <h3>My Classrooms</h3>
            </a>

            <!-- View Results -->
            <a href="/StudentResult/View?studentId=@studentId" class="tile-card student-tile">
                <div class="tile-hover-glow"></div>
                <i class="fas fa-chart-line tile-icon"></i>
                <h3>Check Results</h3>
            </a>

            <!-- Check Attendance -->
            <a href="/StudentAttendance/Index?studentId=@studentId" class="tile-card student-tile">
                <div class="tile-hover-glow"></div>
                <i class="fas fa-calendar-check tile-icon"></i>
                <h3>Check Attendance</h3>
            </a>

            <!-- View & Submit Assignments -->
            <a href="/StudentAssignment/List?studentId=@studentId" class="tile-card student-tile">
                <div class="tile-hover-glow"></div>
                <i class="fas fa-file-alt tile-icon"></i>
                <h3>Assignments</h3>
            </a>

        </div>
    </div>

</body>
</html>
