@model List<ALTIS.Models.Classroom>

<h2>Your Classrooms</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}


<table class="table table-bordered">
    <thead class="table-dark">
        <tr><th>ID</th><th>Title</th><th>CourseID</th><th>Section</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.ClassroomID</td>
                <td>@c.Title</td>
                <td>@c.CourseID</td>
                <td>@c.SectionID</td>
                <td>
                    <a asp-action="Delete"
                       asp-route-id="@c.ClassroomID"
                       class="btn btn-danger"
                       onclick="return confirm('Are you sure you want to delete this classroom?');">
                        Delete
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>

<a href="/Classroom/Add.cshtml" class="btn btn-primary">+ Create New Classroom</a>
<a href="/Auht/DashboardFaculty.cshtml" class="btn btn-secondary ms-2">Back to Dashboard</a>
