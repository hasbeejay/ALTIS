@model List<ALTIS.Models.Student>

<h2 class="text-center">All Registered Students</h2>

<!-- Alert Messages -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped table-hover table-bordered mt-4">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Contact</th>
            <th>Section</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentID</td>
                <td>@s.FirstName @s.LastName</td>
                <td>@s.StudentMail</td>
                <td>@s.Contact</td>
                <td>@s.SectionID</td>
                <td>
                    <a class="btn btn-sm btn-warning me-1" href="/Student/Edit/@s.StudentID">Edit</a>
                    <a class="btn btn-sm btn-danger" href="/Student/Delete/@s.StudentID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Student/Add" class="btn btn-primary">+ Add New Student</a>
<div class="d-flex gap-2">
    <a href="/Auth/DashboardStudent" class="btn btn-secondary">← Back to Dashboard</a>
</div>