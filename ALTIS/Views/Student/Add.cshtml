@model ALTIS.Models.Student

<h2>Add New Student</h2>

<form method="post" asp-action="Add">
    <label>Student ID</label>
    <input asp-for="StudentID" class="form-control" required />

    <label>First Name</label>
    <input asp-for="FirstName" class="form-control" required />

    <label>Last Name</label>
    <input asp-for="LastName" class="form-control" required />

    <label>Contact</label>
    <input asp-for="Contact" class="form-control" />

    <label>Email</label>
    <input asp-for="StudentMail" class="form-control" required />

    <label>Password</label>
    <input asp-for="StudentPassword" type="password" class="form-control" required />

    <label>Address</label>
    <input asp-for="Address" class="form-control" />

    <label>Section ID</label>
    <input asp-for="SectionID" class="form-control" required />

    <br />
    <button type="submit" class="btn btn-primary">Add Student</button>
</form>
