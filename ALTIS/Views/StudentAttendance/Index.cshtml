@model List<ALTIS.Models.AttendanceRecord>

<h2>📅 My Attendance</h2>

@if (Model.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Date</th>
                <th>Classroom</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr class="@(a.Status == "Absent" ? "table-danger" : "table-success")">
                    <td>@a.Date.ToString("yyyy-MM-dd")</td>
                    <td>@a.ClassroomTitle</td>
                    <td>@a.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No attendance records found.</div>
}

<a href="/Auth/DashboardStudent" class="btn btn-secondary">← Back to Dashboard</a>
