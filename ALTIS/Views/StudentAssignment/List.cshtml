@model List<ALTIS.Models.Assignment>

<h2>My Assignments</h2>

<table class="table table-bordered">
    <thead><tr><th>Title</th><th>Classroom</th><th>Due Date</th><th>Action</th></tr></thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Title</td>
                <td>@a.ClassroomTitle</td>
                <td>@a.DueDate.ToShortDateString()</td>
                <td>
                    <a href="/StudentAssignment/Submit?assignmentId=@a.AssignmentID" class="btn btn-sm btn-primary">
                        Submit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Auth/DashboardStudent" class="btn btn-secondary">← Back to Dashboard</a>
